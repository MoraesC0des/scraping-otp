# Configuração do Firebase Analytics (web).
# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto
# Firebase (Configuração do app Web). Estes valores são públicos do lado do navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=