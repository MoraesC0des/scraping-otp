# Configuração do Firebase Analytics (web).
# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto
# Firebase (Configuração do app Web). Estes valores são públicos do lado do navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Opcional: força o "debug mode" do GA4 (eventos aparecem no DebugView).
# Também ativado automaticamente no `vite dev` ou com `?debug_mode=1` na URL.
# NÃO habilite isso no ambiente de produção (desviaria o tráfego real do
# processamento normal para o DebugView).
# VITE_FIREBASE_DEBUG_MODE=1